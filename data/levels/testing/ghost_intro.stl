    (scripttrigger
      (oneshot #t)
      (script "Tux.walk(0);
Text.set_font(\"normal\");
Text.set_text(\"Tux had finally made it to the Ghost Forest.\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"Tux was scared, looking at the sleeping Granitos that have been cursed by Nolok... But he knew he had to defeat him.\");
Text.fade_in(1);
wait(5);
Text.fade_out(1);
wait(1.5);
Tux.walk(140);
Effect.fade_out(2);
wait(3);
Level.finish(true);")
